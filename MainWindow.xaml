<Window x:Class="RefaccionariaDesktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Refaccionaria | Gestión" Height="720" Width="1120" MinHeight="600" MinWidth="900" Background="#F2F5F9">
<Window.Resources>
<Style x:Key="Nav" TargetType="Button"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,13"/><Setter Property="Margin" Value="0,2"/></Style>
</Window.Resources>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#14263D"><StackPanel Margin="18"><TextBlock Text="REFACCIONARIA" Foreground="White" FontSize="19" FontWeight="Bold"/><TextBlock Text="AGRÍCOLA  •  MOTOS" Foreground="#A9BED3" FontSize="11" Margin="0,4,0,28"/><Button Content="Inventario" Click="Inventory_Click" Style="{StaticResource Nav}"/><Button Content="Ventas rápidas" Click="Sales_Click" Style="{StaticResource Nav}"/><Button Content="Corte de caja" Click="CashClose_Click" Style="{StaticResource Nav}"/><Button Content="Respaldar datos" Click="Backup_Click" Style="{StaticResource Nav}"/></StackPanel></Border><Grid Grid.Column="1" Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="Inventario" FontSize="27" FontWeight="Bold" Foreground="#172B45"/><TextBlock x:Name="LowStockText" Text="Control local de piezas y existencias · Productos en mínimo: 0" Foreground="#64748B"/></StackPanel><Grid Grid.Row="1"><Grid x:Name="InventoryPanel"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBox x:Name="SearchBox" Width="250" Height="36" Padding="8" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Equivalencia" Click="Equivalence_Click" Padding="10,8" Margin="4,0"/><Button Content="Eliminar" Click="DeleteProduct_Click" Padding="10,8" Margin="4,0"/><Button Content="Editar" Click="EditProduct_Click" Padding="10,8" Margin="4,0"/><Button Content="+ Nuevo producto" Click="NewProduct_Click" Padding="14,8" Background="#1769AA" Foreground="White" Margin="4,0"/></StackPanel></DockPanel><DataGrid x:Name="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Code}" Width="110"/><DataGridTextColumn Header="Descripción" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="130"/><DataGridTextColumn Header="Marca" Binding="{Binding Brand}" Width="110"/><DataGridTextColumn Header="Existencia" Binding="{Binding Stock}" Width="90"/><DataGridTextColumn Header="Precio" Binding="{Binding Price,StringFormat=C}" Width="100"/></DataGrid.Columns></DataGrid></Grid><Grid x:Name="SalesPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBox x:Name="SaleSearchBox" Width="340" Height="38" Padding="8" VerticalContentAlignment="Center"/><Button Content="Agregar" Click="AddSaleItem_Click" Margin="8,0" Padding="15,7" Background="#1769AA" Foreground="White"/></DockPanel><DataGrid x:Name="CartGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Código" Binding="{Binding Product.Code}" Width="110"/><DataGridTextColumn Header="Producto" Binding="{Binding Product.Name}" Width="*"/><DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/><DataGridTextColumn Header="Precio" Binding="{Binding Product.Price,StringFormat=C}" Width="100"/></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="TotalText" Text="Total: $0.00" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Cobrar y registrar" DockPanel.Dock="Right" Click="Checkout_Click" Padding="18,12" Background="#16845B" Foreground="White"/></DockPanel></Grid></Grid></Grid></Grid></Window>