<Window x:Class="RefaccionariaDesktop.ProductWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nuevo producto" Height="530" Width="470" WindowStartupLocation="CenterOwner"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Registrar refacción" FontSize="23" FontWeight="Bold" Margin="0,0,0,16"/><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Código" VerticalAlignment="Center"/><TextBox x:Name="CodeBox" Grid.Column="1" Margin="0,4" Padding="7"/><TextBlock Text="Descripción" Grid.Row="1" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Padding="7"/><TextBlock Text="Categoría" Grid.Row="2" VerticalAlignment="Center"/><ComboBox x:Name="CategoryBox" Grid.Row="2" Grid.Column="1" Margin="0,4" SelectedIndex="0"><ComboBoxItem Content="Agrícolas"/><ComboBoxItem Content="Motocicletas"/></ComboBox><TextBlock Text="Marca" Grid.Row="3" VerticalAlignment="Center"/><TextBox x:Name="BrandBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Padding="7"/><TextBlock Text="N.º de parte" Grid.Row="4" VerticalAlignment="Center"/><TextBox x:Name="PartBox" Grid.Row="4" Grid.Column="1" Margin="0,4" Padding="7"/><TextBlock Text="Costo MXN" Grid.Row="5" VerticalAlignment="Center"/><TextBox x:Name="CostBox" Grid.Row="5" Grid.Column="1" Margin="0,4" Padding="7" Text="0"/><TextBlock Text="Precio MXN" Grid.Row="6" VerticalAlignment="Center"/><TextBox x:Name="PriceBox" Grid.Row="6" Grid.Column="1" Margin="0,4" Padding="7" Text="0"/><TextBlock Text="Existencia / mínimo" Grid.Row="7" VerticalAlignment="Center"/><StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="StockBox" Width="85" Margin="0,4" Padding="7" Text="0"/><TextBox x:Name="MinBox" Width="85" Margin="8,4" Padding="7" Text="0"/></StackPanel></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14"><Button Content="Cancelar" IsCancel="True" Padding="15,8" Margin="0,0,8,0"/><Button Content="Guardar" Click="Save_Click" Padding="18,8" Background="#1769AA" Foreground="White"/></StackPanel></Grid></Window>